# Variables de las Edge Functions. Copia este archivo como `.env` (ignorado por git) y complétalo.
# Qué hace cada variable: README.md (sección «Variables de entorno»)
# Local:      npx supabase functions serve --env-file supabase/functions/.env
# Producción: npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY las inyecta Supabase.

# --- drive-upload: PDFs del Open Day en una unidad compartida de Drive ---
# Solo en local: "supabase" guarda los PDFs en el bucket openday-documents en vez de Drive
# (para probar sin credenciales de Google). En producción déjala vacía.
DOCUMENT_STORAGE=
# JSON completo de la cuenta de servicio, en una sola línea
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID de la carpeta dentro de la unidad compartida (lo que va después de /folders/ en la URL)
GOOGLE_DRIVE_FOLDER_ID=
# Opcional: solo si usas delegación de dominio en vez de unidad compartida
GOOGLE_IMPERSONATE_USER=
# Orígenes del sitio separados por coma
ALLOWED_ORIGINS=http://localhost:3000

# --- send-email: cola de correos del Open Day ---
# Igual al secreto `email_worker_secret` de Vault
EMAIL_WEBHOOK_SECRET=
# Base de los enlaces de los correos, sin "/" al final
SITE_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
# 465 = TLS directo; 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=
# Contraseña de aplicación de Google, sin espacios
SMTP_PASS=
MAIL_FROM=InspírateUNI <cuenta@tu-dominio>
# Web app de backend/apps-script/credentials (URL /exec y su SHARED_SECRET)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
