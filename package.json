{
  "name": "inspirateuni-web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:e2e:db",
    "test:e2e:db": "cd backend && npx supabase test db",
    "test:e2e:openday": "node backend/tests/e2e/openday_e2e_runner.mjs",
    "test:load:k6": "k6 run backend/tests/load/k6_open_day_hold.js",
    "test:load:pgbench": "bash backend/tests/load/run_pgbench.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "babel-cli": "^6.9.0",
    "babel-plugin-add-module-exports": "^0.2.1",
    "babel-plugin-transform-regenerator": "^6.9.0",
    "babel-preset-es2015": "^6.9.0",
    "bake-cli": "^0.1.6",
    "eslint": "^2.10.2",
    "eslint-config-standard": "^5.3.1",
    "eslint-plugin-promise": "^1.1.0",
    "eslint-plugin-standard": "^1.3.2",
    "mocha": "^2.5.2",
    "standard-version": "^2.2.1",
    "watchd": "github:mklabs/watchd",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0"
  },
  "bake": {
    "description": "Scaffold a basic ES6 setup",
    "scripts": {
      "start": "echo Starting generation of default template",
      "prestart": "echo prestart",
      "poststart": "echo poststart",
      "install": "npm install --loglevel warn --cache-min Infinity",
      "preinstall": "echo Installing dependencies ...",
      "postinstall": "npm ls --depth 0"
    }
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INSPIRATEUNI/inspirateuni-web.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/INSPIRATEUNI/inspirateuni-web/issues"
  },
  "homepage": "https://github.com/INSPIRATEUNI/inspirateuni-web#readme",
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx,mjs,css,json}": [
      "bash -c 'cd frontend && npx biome check --write --no-errors-on-unmatched --files-ignore-unknown=true \"$@\"' --"
    ],
    "frontend/**/*.{ts,tsx}": [
      "bash -c 'cd frontend && npm run typecheck'"
    ],
    "frontend/**/*.md": [
      "prettier --write"
    ]
  }
}