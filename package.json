{
  "name": "inspirateuni-web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test:e2e:db",
    "test:e2e:db": "cd backend && npx supabase test db",
    "test:e2e:openday": "node backend/tests/e2e/openday_e2e_runner.mjs",
    "test:load:k6": "k6 run backend/tests/load/k6_open_day_hold.js",
    "test:load:pgbench": "bash backend/tests/load/run_pgbench.sh",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INSPIRATEUNI/inspirateuni-web.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/INSPIRATEUNI/inspirateuni-web/issues"
  },
  "homepage": "https://github.com/INSPIRATEUNI/inspirateuni-web#readme",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx,mjs,css,json}": [
      "bash -c 'cd frontend && npx biome check --write --no-errors-on-unmatched --files-ignore-unknown=true \"$@\"' --"
    ],
    "frontend/**/*.{ts,tsx}": [
      "bash -c 'cd frontend && npm run typecheck'"
    ],
    "frontend/**/*.md": [
      "prettier --write"
    ]
  }
}
