NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# revisalo con npx supabase status
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: clave pública de hCaptcha para el OTP del Open Day.
# Sin ella no se muestra el captcha (actívalo también en [auth.captcha] de Supabase).
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# Clave secreta de hCaptcha: el servidor verifica el captcha de los formularios públicos.
HCAPTCHA_SECRET=
# Web app de Apps Script de los formularios públicos (voluntariado, visitas guiadas,
# Inspírate Girl): URL /exec y su SHARED_SECRET. Solo las lee el servidor (sin NEXT_PUBLIC_).
# Cómo obtenerlas: backend/apps-script/forms/README.md
FORMS_APPS_SCRIPT_URL=
FORMS_APPS_SCRIPT_SECRET=
